NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase personal access token, only for `npm run db:types`.
# Create one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Resend, for booking emails. Without a key, emails are printed to the server
# log instead of sent. Create one at https://resend.com/api-keys
RESEND_API_KEY=
# Must use a domain verified in Resend. Until chalotrek.in is verified, use
# "Chalo Trek <onboarding@resend.dev>", which only delivers to your own Resend email.
EMAIL_FROM=
